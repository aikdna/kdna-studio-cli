{
  "name": "@aikdna/kdna-studio-cli",
  "version": "0.10.0",
  "description": "Official KDNA Studio command-line authoring entry for creating, reviewing, compiling, and exporting .kdna judgment assets through the KDNA toolchain.",
  "type": "commonjs",
  "bin": {
    "kdna-studio": "bin/kdna-studio.js"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "lint": "find bin src tests scripts -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.js",
    "test:all": "npm run lint && npm run check:protocol-names && npm test",
    "check:protocol-names": "node scripts/check-current-protocol-names.js",
    "release:check": "node scripts/release-check.js",
    "prepublishOnly": "npm run test:all && npm run release:check"
  },
  "keywords": [
    "kdna",
    "kdna-studio",
    "kdna-studio-cli",
    "authoring",
    "provenance",
    "judgment-cards"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikdna/kdna-studio-cli.git"
  },
  "homepage": "https://aikdna.com",
  "bugs": {
    "url": "https://github.com/aikdna/kdna-studio-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aikdna/kdna-core": "0.18.1",
    "@aikdna/kdna-studio-core": "1.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cbor-x": "^1.6.4"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "author": ""
}
