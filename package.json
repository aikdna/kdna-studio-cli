{
  "name": "@aikdna/kdna-studio-cli",
  "version": "0.13.0-rc.components.1",
  "description": "Terminal Host for current typed Studio creation and separate human or authorized Agent adoption channels.",
  "type": "commonjs",
  "bin": {
    "kdna-studio": "bin/kdna-studio.js"
  },
  "files": [
    "bin/kdna-studio.js",
    "src/terminal-workspace.js",
    "src/public-bindings.json",
    "docs/CREATION_COMMAND_CONTRACT.md",
    "docs/TERMINAL_AGENT_CREATION.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "src/component-operations.js"
  ],
  "scripts": {
    "lint": "node --check bin/kdna-studio.js && node --check src/terminal-workspace.js && node --check src/component-operations.js",
    "test": "node --test tests/current-components/*.test.cjs tests/current/*.test.js",
    "test:all": "node scripts/run-test-all.js",
    "test:candidate-chain": "node scripts/verify-runtime-candidate-chain.js",
    "verify:candidate-sources": "node scripts/verify-runtime-candidate-sources.js",
    "check:protocol-names": "node scripts/check-current-protocol-names.js",
    "release:check": "node scripts/release-check.js",
    "release:generate-evidence": "node scripts/generate-release-evidence.js",
    "release:publish-verified": "node scripts/publish-verified-artifact.js",
    "prepublishOnly": "node scripts/run-test-all.js && node scripts/verify-runtime-candidate-chain.js && node scripts/release-check.js"
  },
  "keywords": [
    "kdna",
    "agent-native",
    "creation",
    "terminal"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikdna/kdna-studio-cli.git"
  },
  "homepage": "https://aikdna.com",
  "bugs": {
    "url": "https://github.com/aikdna/kdna-studio-cli/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aikdna/kdna-core": "file:vendor/aikdna-kdna-core-0.24.0-rc.component-semantics.2.tgz",
    "@aikdna/kdna-read": "file:vendor/aikdna-kdna-read-0.3.0-rc.component-semantics.2.tgz",
    "@aikdna/kdna-studio-core": "file:vendor/aikdna-kdna-studio-core-4.0.0-rc.components.1.tgz"
  },
  "directories": {
    "test": "tests"
  },
  "author": "",
  "overrides": {
    "fast-uri": "3.1.7"
  },
  "exports": {
    "./package.json": "./package.json"
  }
}
