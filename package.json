{
  "name": "@aikdna/kdna-studio-cli",
  "version": "0.10.1",
  "description": "Official KDNA Studio command-line authoring entry for creating, reviewing, compiling, and exporting .kdna judgment assets through the KDNA toolchain.",
  "type": "commonjs",
  "bin": {
    "kdna-studio": "bin/kdna-studio.js"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "lint": "node scripts/run-lint.js",
    "pretest": "node scripts/acquire-trusted-npm-release.js",
    "test": "node --test tests/*.test.js",
    "test:all": "node scripts/run-test-all.js",
    "test:runtime": "node scripts/run-product-tests.js",
    "test:candidate-chain": "node scripts/verify-runtime-candidate-chain.js",
    "verify:candidate-sources": "node scripts/verify-runtime-candidate-sources.js",
    "check:protocol-names": "node scripts/check-current-protocol-names.js",
    "release:check": "node scripts/release-check.js",
    "release:generate-evidence": "node scripts/generate-release-evidence.js",
    "release:publish-verified": "node scripts/publish-verified-artifact.js",
    "prepublishOnly": "node scripts/run-test-all.js && node scripts/verify-runtime-candidate-chain.js && node scripts/release-check.js"
  },
  "keywords": [
    "kdna",
    "kdna-studio",
    "kdna-studio-cli",
    "authoring",
    "provenance",
    "judgment-cards"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikdna/kdna-studio-cli.git"
  },
  "homepage": "https://aikdna.com",
  "bugs": {
    "url": "https://github.com/aikdna/kdna-studio-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aikdna/kdna-core": "0.20.0",
    "@aikdna/kdna-studio-core": "2.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cbor-x": "^1.6.4"
  },
  "directories": {
    "test": "tests"
  },
  "author": ""
}
